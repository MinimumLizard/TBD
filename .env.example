# Every setting the platform reads, with NO values. Copy to `.env` (gitignored) for local runs and fill it in.
# In GitHub Actions these are repository secrets; on Vercel, project environment variables.

# local | staging | production
APP_ENV=

# Postgres connection string. Supabase: Project Settings -> Database -> Connection string (URI), session pooler.
DATABASE_URL=

# Raw archive. "local:<folder>" for development; "s3" for Cloudflare R2 (and the S3_* settings below).
RAW_STORE=
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
# An R2 API token with Object Read & Write on that bucket only (never an account-wide token).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Healthchecks.io: https://hc-ping.com/<project ping key>. Each job pings <base>/<source>-<job>.
HEALTHCHECKS_BASE_URL=

# Second copy of the archive and of the nightly database export (decision 0003): Backblaze B2's S3 API.
# "local:<folder>" for development; "s3" with the SECONDARY_S3_* settings below.
SECONDARY_STORE=
# Backblaze B2: https://s3.<region>.backblazeb2.com
SECONDARY_S3_ENDPOINT_URL=
SECONDARY_S3_BUCKET=
SECONDARY_S3_ACCESS_KEY_ID=
SECONDARY_S3_SECRET_ACCESS_KEY=

# --- The website (web/, on Vercel) ---------------------------------------------------------------------------
# The website reads the database as the read-only web_reader role (migration 0006), never as the jobs' owner login:
#   DATABASE_URL=<session pooler URI with user web_reader.<project ref> and its password>
# Tests only: lets a request act as another tier with the x-test-tier header. Ignored when APP_ENV or VERCEL_ENV is
# production. Never set it on Vercel.
ALLOW_TEST_TIERS=
