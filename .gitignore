# Data never goes in git (decision 0003). Archives belong in R2/B2 and the founders own copies.
*.sqlite
*.sqlite.xz
*.bundle
*.parquet
archive/
repo-backup-*/

# Secrets
.env
.env.*
!.env.example

# Python / Node
__pycache__/
.venv/
node_modules/

# Default local raw archive for development (RAW_STORE unset)
.local/

